outputs_gemma_fixed/
outputs_medgemma_fixed/
outputs_*/
kaggle/raw_output/
results_extracted/

# Archives
*.zip

# W&B + MLflow local cache
wandb/
mlruns/
*.log

# Kaggle session logs

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Obsidian notes app settings (not research files)
.obsidian/

# Compiled PDF (regenerated from LaTeX source)
paper/main.pdf

# Jupyter checkpoints
.ipynb_checkpoints/

# Secrets (never commit)
.env
*.netrc

# large regenerable artifacts (keep out of git)
